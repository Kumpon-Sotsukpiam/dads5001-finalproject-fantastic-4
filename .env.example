# ── MongoDB Atlas ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=dads5001
MONGO_DB=dads5001
MONGO_COLLECTION=bangkok_complaints

# ── Snowflake (key-pair authentication) ───────────────────────
SNOWFLAKE_ACCOUNT=<account_identifier>
SNOWFLAKE_USER=<username>
# Local: path to your private key file (do NOT commit the key!)
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
# Streamlit Cloud: paste key content instead of a path
# SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DADS5001
SNOWFLAKE_SCHEMA=PUBLIC

# ── Groq (AI mode: insights + RAG chatbot) ────────────────────
GROQ_API_KEY=<your_groq_api_key>
